# Add this line if you want to avoid checking in generated files from Swift Package Manager
.build/
# Package.pins is generated at swift build or swift package resolve
Package.pins

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
# Pods/

# Carthage
#
# Add this line if you want to avoid checking in generated files from Carthage.
Carthage/Build/

# Fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate
